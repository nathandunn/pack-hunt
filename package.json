{
  "name": "@precog/pack-hunt",
  "version": "0.4.0",
  "type": "module",
  "description": "Asymmetric predator/prey crossing simulation on @precog/sim-core",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --format=iife --outfile=public/app.js --minify",
    "build:ts": "tsc -p .",
    "test": "npm run build:ts && node --test dist/test/*.js"
  },
  "dependencies": { "@precog/sim-core": "file:../sim-core", "@precog/agent-forge": "file:../agent-forge" },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.23.0",
    "typescript": "^5.5.0"
  },
  "license": "MIT"
}
